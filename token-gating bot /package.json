{
    "name": "bot-practice",
    "version": "0.0.1",
    "private": true,
    "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx --watch src/index.ts",
    "gen:keys": "tsx scripts/generateKeys.ts",
    "lint": "eslint src",
    "start": "tsx src/index.ts",
    "clear:group": "tsx scripts/clearGroup.ts",
    "clear:group:simple": "tsx scripts/clearGroupSimple.ts",
    "group:status": "tsx scripts/groupStatus.ts",
    "test": "npm run build && echo 'Build successful! Run npm start to launch your bot.'"
  },
    "dependencies": {
        "@xmtp/node-sdk": "2.1.0",
        "dotenv": "^16.5.0",
        "ethers": "^6.13.5",
        "uint8arrays": "^5.1.0",
        "viem": "^2.26.3"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "tsx": "^4.7.0",
        "typescript": "^5.7.3"
    },
    "engines": {
        "node": ">=20"
    }
}
