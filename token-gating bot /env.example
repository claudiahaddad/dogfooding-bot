# Required Environment Variables
# Your wallet's private key (must start with 0x)
WALLET_KEY=0x1234567890abcdef...

# The ERC20 token contract address that gates access to the group
TOKEN_ADDRESS=0xF8987852A03903b0559FE6A31ECD5e3994eA0f16

# Minimum number of tokens required to join/stay in group
MINIMUM_TOKEN_BALANCE=5.0

# Optional Environment Variables
# Encryption key for local database (if not set, will use default)
# ENCRYPTION_KEY=your-encryption-key-here

# XMTP environment: "dev" or "production" (defaults to "dev")
# XMTP_ENV=dev
